<?xml version="1.0" encoding="utf-8"?>
<!-- DAVE-PR-3288: local package feed toggle.
     This NuGet.config is NOT used by the stock local/dev build (it lives in
     patches/ and is only copied into the Docker build context by the
     Dockerfile's build stage). It prepends a local feed containing the
     from-source, PR #3288-patched Discord.Net 3.20.2 packages so that the
     app's unchanged `<PackageReference Include="Discord.Net" Version="3.20.2" />`
     resolves the patched component assemblies (Discord.Net.WebSocket /
     Discord.Net.Dave) from ./local-packages, while the Discord.Net metapackage
     shell and everything else come from nuget.org.
     CLEANUP (once upstream ships the fix): delete this file, the DAVE-PR-3288
     blocks in the Dockerfile, and patches/dave-pr-3288.patch. See
     patches/README.md. -->
<configuration>
  <packageSources>
    <clear />
    <!-- DAVE-PR-3288: patched Discord.Net 3.20.2 packages, populated by the discordnet build stage -->
    <add key="dave-pr-3288-local" value="./local-packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
